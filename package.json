{
  "name": "shop",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "demo": "concurrently -n api,web -c blue,green \"npm run demo -w server\" \"npm run dev -w client\"",
    "seed": "npm run seed -w server",
    "make-admin": "npm run make-admin -w server",
    "backup": "npm run backup -w server",
    "restore": "npm run restore -w server --",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.34"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10"
  }
}
