# Copy this file to server/.env (a file, not a folder; it is gitignored) and fill it in.
# Atlas: Database > Connect > Drivers gives the connection string; add your IP under Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional, defaults to "shop".
MONGODB_DB=shop
# Optional, defaults to 4000.
PORT=4000
# Optional: Razorpay online payments in TEST mode (Dashboard > Account & Settings > API keys, while in Test Mode).
# Leave out for Cash on Delivery only. Live keys (rzp_live_...) are refused.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Optional: the secret you set for the webhook (Dashboard > Webhooks; URL https://<your-site>/api/razorpay/webhook,
# events payment.captured and order.paid). Webhooks only reach a publicly reachable server.
# RAZORPAY_WEBHOOK_SECRET=
