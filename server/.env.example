# Copy this file to server/.env (a file, not a folder; it is gitignored) and fill it in.
# Atlas: Database > Connect > Drivers gives the connection string; add your IP under Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional, defaults to "shop".
MONGODB_DB=shop
# Optional, defaults to 4000.
PORT=4000
# Optional: Razorpay online payments in TEST mode (Dashboard > Account & Settings > API keys, while in Test Mode).
# Leave out for Cash on Delivery only. Live keys (rzp_live_...) are refused.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Optional: the secret you set for the webhook (Dashboard > Webhooks; URL https://<your-site>/api/razorpay/webhook,
# events payment.captured and order.paid). Webhooks only reach a publicly reachable server.
# RAZORPAY_WEBHOOK_SECRET=
# Optional: order emails through Brevo (brevo.com → SMTP & API → API keys). Without a key they are only printed in
# the server log. MAIL_FROM must be a sender you verified in Brevo (Senders, domains & IPs).
# BREVO_API_KEY=
# MAIL_FROM=you@example.com
# MAIL_FROM_NAME=Bazaar
# Where new-order alerts go (one address, or several separated by commas). Default: every admin account's email.
# ADMIN_EMAIL=
# The site address used in email links (default http://localhost:5173), e.g. https://<your-site>.onrender.com
# PUBLIC_URL=
# Optional: the header the host's edge sets to the visitor's IP, for limiting login tries per network
# (cf-connecting-ip on Render, already set in render.yaml). Locally leave it unset.
# CLIENT_IP_HEADER=
